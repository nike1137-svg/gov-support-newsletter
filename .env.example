# .env 로 복사해 채운다. .env 는 커밋되지 않는다. GitHub Actions 에서는 같은 이름의 Secrets 로 넣는다.
OPENAI_API_KEY=
BIZINFO_API_KEY=
# K-Startup 은 소스 채택 기준(C3)에서 탈락해 파이프라인에서는 쓰지 않는다. 측정 도구(tools/probe_sources.py)만 쓴다
KSTARTUP_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 이면 보내지 않는다 (기본). run.py --send 가 우선한다
DRY_RUN=1
